{
  "name": "mathlab",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "audit:release": "node scripts/release-audit.mjs",
    "check:release": "npm run audit:release && npm run check"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.1",
    "typescript": "5.8.3",
    "vite": "7.3.5",
    "vitest": "3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
